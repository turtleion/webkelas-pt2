# ============================================================================
# Supabase — konfigurasi frontend (Vite)
# ----------------------------------------------------------------------------
# Buat proyek di https://supabase.com/dashboard, lalu salin nilai dari
# Project Settings → API.
#
#   VITE_SUPABASE_URL:        Project URL
#   VITE_SUPABASE_PUBLISHABLE_KEY:  anon public key
#
# HANYA kunci anon/publishable yang dipakai frontend — aman untuk disebar.
# Kunci service-role TIDAK PERNAH diletakkan di frontend / .env frontend.
# ============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
